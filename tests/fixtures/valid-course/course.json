{
  "schemaVersion": "1.0",
  "course": {
    "id": "flicc-course-example",
    "title": "科学否认的五种手法：用 FLICC 核查气候视频",
    "language": "zh-CN",
    "parts": [
      {
        "id": "part-1",
        "title": "从相信谁，转向怎样核查",
        "pieces": [
          {
            "id": "piece-1",
            "title": "课程挑战",
            "blocks": [
              {
                "id": "intro",
                "type": "text",
                "content": "多数“拆穿视频”的课，会让学生看完一段视频，再记住另一段视频给出的结论。这门课要求学生把核查视频也视为需要核查的对象，并对不同立场使用同一套方法：确认来源、检查证据、分析推理。"
              },
              {
                "id": "evidence-image",
                "type": "images",
                "items": [
                  {
                    "source": "assets/images/example.svg",
                    "alt": "从选择相信对象转向使用统一核查方法的示意图"
                  }
                ]
              },
              {
                "id": "learning-goal-check",
                "type": "singleChoice",
                "blocking": true,
                "prompt": "这门课最核心的学习目标是什么？",
                "options": [
                  {
                    "id": "remember-review",
                    "label": "记住核查视频给出的所有结论"
                  },
                  {
                    "id": "same-tool",
                    "label": "对不同立场使用同一套核查工具"
                  },
                  {
                    "id": "choose-side",
                    "label": "判断应该相信原视频还是核查视频"
                  }
                ],
                "assessment": {
                  "mode": "graded",
                  "correctOptionId": "same-tool",
                  "correctFeedback": "正确。核查者也可能出错，工具需要对所有来源一致。",
                  "incorrectFeedback": "回看课程挑战：目标是掌握可以迁移的核查方法，而不是更换相信对象。"
                }
              },
              {
                "id": "reflection",
                "type": "fillBlank",
                "blocking": true,
                "prompt": "写下你会如何核查气候视频中的一条具体主张。",
                "assessment": {
                  "mode": "reflection",
                  "rubric": "回答应指出要核查的具体主张，并包含至少一项明确、可执行的来源或证据核查动作。"
                }
              }
            ]
          },
          {
            "id": "source-check",
            "title": "从完整文档定位证据（结构测试）",
            "blocks": [
              {
                "id": "source-check-instruction",
                "type": "text",
                "content": "核查引用时，先打开完整原始文档，再定位具体章节或图表。下面的文件是结构测试材料，不是气候研究论文，也不能作为气候结论的证据。请用它练习在完整文档中定位信息。"
              },
              {
                "id": "source-paper",
                "type": "pdf",
                "title": "PDF 原始材料（结构测试，非真实论文）",
                "source": "assets/pdfs/source-paper-test.pdf"
              },
              {
                "id": "source-heading-check",
                "type": "fillBlank",
                "blocking": true,
                "prompt": "打开完整 PDF，填写第 2 页的章节标题。",
                "assessment": {
                  "mode": "graded",
                  "acceptedAnswers": [
                    "2. Evidence Check",
                    "Evidence Check"
                  ],
                  "caseSensitive": false,
                  "correctFeedback": "正确。你已经从完整文档中定位到指定章节。",
                  "incorrectFeedback": "请翻到第 2 页，读取页面顶部的章节标题。"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
