{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-imprint.local/schemas/annotation-revision-plan.schema.json",
  "title": "Annotation revision plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "baseBlueprintHash", "baseDefinitionHash", "baseSourceMapHash", "entries"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "planId": {"$ref": "#/$defs/id"},
    "baseBlueprintHash": {"$ref": "#/$defs/hash"},
    "baseDefinitionHash": {"$ref": "#/$defs/hash"},
    "baseSourceMapHash": {"$ref": "#/$defs/hash"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "relativePointer", "beforeHash", "value"],
      "properties": {
        "op": {"const": "replace"},
        "relativePointer": {"type": "string", "pattern": "^/(?!/).+"},
        "beforeHash": {"$ref": "#/$defs/hash"},
        "value": {}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotationId", "classification", "targetId", "summary", "decisionId", "operations"],
      "properties": {
        "annotationId": {"$ref": "#/$defs/id"},
        "classification": {"enum": ["mechanical", "semantic", "runtime-bug"]},
        "targetId": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "decisionId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}}
      }
    }
  }
}
