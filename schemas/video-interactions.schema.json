{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/video-interactions.schema.json",
  "title": "Platform Video Interactions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "video"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "durationSeconds", "events"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$))"
          }
        },
        "durationSeconds": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["graded", "survey", "reflection"]
        },
        "correctOptionId": {
          "$ref": "#/$defs/id"
        },
        "acceptedAnswers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rubric": {
          "type": "string",
          "minLength": 1
        },
        "correctFeedback": {
          "type": "string",
          "minLength": 1
        },
        "incorrectFeedback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "assessment"],
      "properties": {
        "type": {
          "enum": ["singleChoice", "fillBlank"]
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timeSeconds", "blocking", "prompt", "interaction"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "timeSeconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "needs-timing"
        },
        "blocking": {
          "type": "boolean"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "interaction": {
          "$ref": "#/$defs/interaction"
        }
      },
      "oneOf": [
        {
          "properties": {
            "timeSeconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "not": {
            "required": ["status"]
          }
        },
        {
          "required": ["anchor", "status"],
          "properties": {
            "timeSeconds": {
              "type": "null"
            },
            "status": {
              "const": "needs-timing"
            }
          }
        }
      ]
    }
  }
}
